# Game server
PORT=8080
# Local Docker Postgres. For Neon paste your connection string here (or set it on the host):
#   postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://campus:campus@localhost:5432/campuslife

# Web client (build time). Locally and in Codespaces it is detected automatically.
# On Netlify, set it to your deployed game server, using wss://
# VITE_WS_URL=wss://your-game-server.onrender.com
